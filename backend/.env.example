NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://student_rewards_user:YOUR_PASSWORD@localhost:3306/student_rewards"

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-20-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-refresh-secret-at-least-20-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
BCRYPT_ROUNDS=12
PASSWORD_RESET_EXPIRES_MINUTES=30

# Leave SMTP values blank in development to print reset links in the backend terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CampusSpark <no-reply@campusspark.local>"
